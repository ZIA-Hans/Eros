  }
  .xt-quick-add-drawer__content .wt-product__main.rte .wt-product__name a {
    text-decoration: none;
  }
  .xt-quick-add-drawer__content .product__tax.caption.rte {
    margin-bottom: 0;
  }
  .xt-quick-add-drawer__content .wt-product__options {
    margin-top: 15px;
  }
  .xt-quick-add-drawer__content .wt-product__option .wt-product__option__dropdown {
    margin-bottom: 0;
  }
  .xt-quick-add-drawer__content .wt-product__name {
