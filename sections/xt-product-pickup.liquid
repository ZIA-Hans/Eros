  {%- comment -%} ============ 移动端：2×n 网格平铺 ============ {%- endcomment -%}
  @media (max-width: 767px) {
    /* 外层 section 留白收紧 */
    .xt-product-pickup {
      padding: 24px 16px;
    }
    .xt-product-pickup__header {
      margin-bottom: 20px;
    }

    /* 网格：固定 2 列，自动行数 */
    .xt-product-pickup__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);  /* 2 列等宽 */
      gap: 12px;                              /* 行列间距 12px */
    }

    /* 卡片内部重排：图片 → 颜色options → 标题 → 价格 */
    .xt-product-pickup__item color-swatch {
      display: flex;
      flex-direction: column;
    }
    .xt-product-pickup__item .card__container {
      display: grid;
      grid-template-columns: 1fr;
      /* 图片行 与 quick-add 行 用同一 grid-row，实现真正叠加 */
      grid-template-rows: auto auto auto auto;
