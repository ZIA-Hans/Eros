  .xt-quick-add-drawer__content .xt-quick-add-carousel__track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    height: auto;
  }
  .xt-quick-add-drawer__content .xt-quick-add-carousel .swiper-slide {
    flex-shrink: 0;
    height: auto;
  }
  {%- comment -%} 统一所有媒体（img/video）为 7:8 盒子，object-fit:cover 裁剪对齐 {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quick-add-carousel .swiper-slide img,
  .xt-quick-add-drawer__content .xt-quick-add-carousel .swiper-slide video {
