    .xt-product-pickup__item .card__quick-add-container button span {
      font-size: 0;                       /* 原 span 文案同步隐藏 */
    }
    .xt-product-pickup__item .card__quick-add-container button::after {
      content: "QUICK ADD";
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.5px;
      color: #2B2B2B;
    }
    .xt-product-pickup__item .card__quick-add-container button[disabled]::after {
      content: "SOLD OUT";                /* 售罄时展示 SOLD OUT */
