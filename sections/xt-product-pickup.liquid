  .xt-quick-add-drawer__content .xt-quantity-bundle__btn {
    width: auto;
    height: auto;
    padding: 7px;
    border-radius: 4px;
    cursor: pointer;
    flex-direction: column;
    gap: 6px;
    line-height: 1.3;
    position: relative;
  }
  {%- comment -%} 顶部行：Save $X Free Shipping {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__save {
    color: #A65D4A;
    font-family: Arial;
    font-size: 10px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%; /* 14px */
    letter-spacing: -0.2px;
  }
  {%- comment -%} 底部行：左 N items + 右购物车图标，space-between 撑开 {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__qty {
    color: #2B2B2B;
    font-family: Arial;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%; /* 19.6px */
    letter-spacing: -0.28px;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    flex-shrink: 0;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__cart svg {
    display: block;
    width: 28px;
    height: 28px;
  }
  {%- comment -%} 选项统一底色 #FAEEE5（无选中态）{%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__btn {
    background: #FAEEE5;
    border: 1px solid #D2D2D2;
  }
  .xt-quick-add-drawer__content .wt-product__feature-tags {
    margin: 16px 0;
  }
  .xt-quick-add-drawer__content::-webkit-scrollbar {
    display: none;
  }
  .xt-quick-add-drawer__content .product-image a {
    pointer-events: none;
  }
  {%- comment -%} SKU 促销徽章定位
  主题原生 promotion 是 position:absolute + top:0，相对整个 .wt-product 容器定位
  （靠 translate -75% 拉到第一行 option 上方）。商详页 .wt-product 是 row 布局，
  容器顶部 = option 区顶部，所以视觉上贴在 option 上；抽屉是 column 布局，
  容器顶部 = 图片顶部，导致徽章错位。
  这里把定位上下文收窄到单个 f-button__list__item，让徽章真正贴在每个按钮上。{%- endcomment -%}
  .xt-quick-add-drawer__content .f-button__list__item {
    position: relative;
  }
  .xt-quick-add-drawer__content .wt-product__option-promotion {
    top: 0;
    transform: translate(2px, -75%);
  }
  {%- comment -%} 查看完整详情入口（Drawer 内容最下方，文字 + 圆圈箭头图标）{%- endcomment -%}
  .xt-quick-add-drawer__view-all-container {
    display: flex;
    padding: 0 16px 20px;
  }
  .xt-quick-add-drawer__view-all-container a {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #2B2B2B;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.28px;
  }
  .xt-quick-add-drawer__view-all-container a svg {
    flex-shrink: 0;
  }
</style>

{% schema %}
{
  "name": "XT 商品选购区",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "精选商品"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "点击商品快速选购"
    },
    {
      "type": "header",
      "content": "卡片样式"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        { "value": "adapt", "label": "适应图片" },
        { "value": "portrait", "label": "纵向 3:4" },
        { "value": "square", "label": "正方形 1:1" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_product_rating",
      "label": "显示评分",
      "default": false
    },
    {
      "type": "header",
      "content": "Quick-Add 快速选购"
    },
    {
