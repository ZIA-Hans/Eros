  .xt-quick-add-drawer__content .wt-product__add-to-cart_form.main-product__buy-buttons--container {
    margin-top: 16px;
  }
  {%- comment -%} Quantity 模拟 option + 3 Pairs 快捷加购按钮 {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__btn {
    width: auto;
    min-width: 5rem;
    height: auto;
    min-height: 3rem;
    padding: 0.6rem 1.5rem;
    cursor: pointer;
    flex-direction: column;
    gap: 2px;
    line-height: 1.3;
    position: relative;
  }
  {%- comment -%} 促销徽章：顶部常驻（$X Off Free shipping）{%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__badge {
    color: #A65D4A;
    font-family: "PingFang SC", Arial, sans-serif;
    font-size: 9px;
    font-style: normal;
    font-weight: 600;
    line-height: 140%;
    letter-spacing: -0.18px;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__label {
    font-size: calc(var(--font-base-size, 14px) - 2px);
  }
  {%- comment -%} 价格区：折前价（左，划线）+ 折后价（右）横排 {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__prices {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__price {
    font-size: 9px;
    font-family: "PingFang SC", Arial, sans-serif;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.18px;
    color: #2B2B2B;
  }
  .xt-quick-add-drawer__content .xt-quantity-bundle__price--compare {
    text-decoration: line-through;
    color: rgba(43, 43, 43, 0.70);
  }
  {%- comment -%} 选中态：复用主题 option 选中边框色 {%- endcomment -%}
  .xt-quick-add-drawer__content .xt-quantity-bundle__item--selected .xt-quantity-bundle__btn {
    border-color: var(--color-input-border-active, #2B2B2B);
  }
  .xt-quick-add-drawer__content .wt-product__feature-tags {
    margin: 16px 0;
  }
  .xt-quick-add-drawer__content::-webkit-scrollbar {
    display: none;
  }
  .xt-quick-add-drawer__content .product-image a {
    pointer-events: none;
  }
  {%- comment -%} SKU 促销徽章定位
  主题原生 promotion 是 position:absolute + top:0，相对整个 .wt-product 容器定位
  （靠 translate -75% 拉到第一行 option 上方）。商详页 .wt-product 是 row 布局，
  容器顶部 = option 区顶部，所以视觉上贴在 option 上；抽屉是 column 布局，
  容器顶部 = 图片顶部，导致徽章错位。
  这里把定位上下文收窄到单个 f-button__list__item，让徽章真正贴在每个按钮上。{%- endcomment -%}
  .xt-quick-add-drawer__content .f-button__list__item {
    position: relative;
  }
  .xt-quick-add-drawer__content .wt-product__option-promotion {
    top: 0;
    transform: translate(2px, -75%);
  }
  {%- comment -%} 查看完整详情入口（Drawer 内容最下方，文字 + 圆圈箭头图标）{%- endcomment -%}
  .xt-quick-add-drawer__view-all-container {
    display: flex;
    padding: 0 16px 20px;
  }
  .xt-quick-add-drawer__view-all-container a {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #2B2B2B;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.28px;
  }
  .xt-quick-add-drawer__view-all-container a svg {
    flex-shrink: 0;
  }
</style>

{% schema %}
{
  "name": "XT 商品选购区",
