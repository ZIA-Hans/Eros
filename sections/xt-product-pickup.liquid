{%- comment -%}
  XT Product Pickup — 商品卡片 + Quick-Add 抽屉选购区
  复用主题现有: card.liquid / quick-add-button.liquid / quick-add.js
{%- endcomment -%}

{%- if section.settings.enable_quick_add_button -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%} 移动端 Quick-Add 用底部 Drawer + 多图轮播，需加载 swiper.css + slider.js {%- endcomment -%}
{{ 'swiper.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'slider.js' | asset_url }}" defer="defer"></script>

<div class="xt-product-pickup" data-section-id="{{ section.id }}">

  {%- if section.settings.title != blank -%}
    <div class="xt-product-pickup__header">
      <h2 class="xt-product-pickup__title">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="xt-product-pickup__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="xt-product-pickup__grid">
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        <div class="xt-product-pickup__item" {{ block.shopify_attributes }}>
          {%- if prod != blank -%}
            {% render 'card',
              card_product: prod,
              img: prod.featured_media,
              title: prod.title,
              subtitle: prod.vendor,
              rating: section.settings.show_product_rating,
              options: false,
              url: prod.url,
              uri: prod.handle,
              text_alignment: 'center',
              variants: prod.variants,
              product_options: prod.options,
              product: prod,
              media_aspect_ratio: section.settings.image_ratio,
              enable_quick_add_button: section.settings.enable_quick_add_button,
              quick_add_mode: section.settings.quick_add_mode,
              enable_vendor_link: false,
              show_video: false
            %}
          {%- else -%}
            <div class="xt-product-pickup__placeholder">
              <p>在 Theme Editor 选择商品</p>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="xt-product-pickup__empty">
      <p>点击左侧 "Add block" 添加商品</p>
    </div>
  {%- endif -%}

  {%- comment -%} 移动端 Quick-Add 底部 Drawer（PC 走主题原生侧边栏，由 JS 按 innerWidth 判定）{%- endcomment -%}
  <sl-drawer id="xt-quick-add-drawer-{{ section.id }}" class="xt-quick-add-drawer" placement="bottom" label="Quick Add" no-header>
    <div class="xt-quick-add-drawer__header">
      <span class="xt-quick-add-drawer__title">Quick Add</span>
      <div class="xt-quick-add-drawer__close" role="button" tabindex="0" aria-label="{{ 'aria-label.close-button' | t }}">
        {% render 'icons', id: 'close' %}
      </div>
    </div>
    <div class="xt-quick-add-drawer__loader">{% render 'loader' %}</div>
    <div class="xt-quick-add-drawer__content"></div>
    <div class="xt-quick-add-drawer__view-all-container hidden">
      <a href="#">
        <span>{{ 'general.quick_add.view_all_details' | t }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M5.65479 0.0600586C9.51861 -0.152443 12.5106 2.91321 12.1147 6.78467C11.8286 9.58123 9.47831 11.8998 6.67529 12.1294C2.61645 12.4617 -0.667983 8.81874 0.186035 4.80322C0.723795 2.27506 3.05394 0.203058 5.65479 0.0600586ZM5.93311 0.419434C1.71437 0.54172 -0.971454 5.17125 1.15674 8.87744C2.95093 12.0014 7.21461 12.7812 9.9126 10.3198C13.6075 6.94832 11.4901 0.778133 6.53857 0.431152V0.430176L5.93311 0.419434Z" fill="#2B2B2B" stroke="#2B2B2B" stroke-width="0.1"/>
          <path d="M6.57642 4.09937C6.78668 4.55143 7.19224 4.9223 7.59985 5.21655C8.14374 5.60917 8.75446 5.87481 9.42114 5.97144L9.46606 5.97827L9.46313 6.02417L9.44751 6.26636L9.44458 6.3103L9.39966 6.31323C8.90265 6.34052 8.39092 6.5501 7.95435 6.79663C7.39704 7.11145 6.83775 7.57009 6.57153 8.1521L6.55786 8.1814H6.21704L6.22583 8.12378C6.2686 7.85002 6.45121 7.60098 6.61646 7.40308C6.94688 7.00716 7.38575 6.70314 7.82446 6.45093L7.82642 6.44897H7.82739L8.08521 6.32007H2.82935V5.94507H8.11548L7.61157 5.67358L7.60767 5.67163V5.67065C7.19056 5.40511 6.71252 5.00233 6.43091 4.58862C6.34397 4.46085 6.24692 4.31378 6.22583 4.14038L6.21899 4.08765L6.27271 4.08472L6.52856 4.07104L6.56274 4.06909L6.57642 4.09937Z" fill="#2B2B2B" stroke="white" stroke-width="0.1"/>
        </svg>
      </a>
    </div>
  </sl-drawer>

</div>

<script>
(function() {
  function init() {
    const section = document.querySelector('.xt-product-pickup[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const drawer = document.getElementById('xt-quick-add-drawer-{{ section.id }}');
    if (!drawer) return;

    // 移动端走底部 Drawer，PC 走主题原生侧边栏（与主题 quick-add.js 的 768 断点一致）
    const isMobile = () => window.innerWidth < 768;

    const contentEl = drawer.querySelector('.xt-quick-add-drawer__content');
    const loaderEl = drawer.querySelector('.xt-quick-add-drawer__loader');
    const closeBtn = drawer.querySelector('.xt-quick-add-drawer__close');
    const viewAllContainer = drawer.querySelector('.xt-quick-add-drawer__view-all-container');

    let currentTrigger = null;
    let currentAbortController = null;

    function hideViewAllDetails() {
      viewAllContainer?.classList.add('hidden');
    }

    function showViewAllDetails(productUrl) {
      if (!viewAllContainer) return;
      const link = viewAllContainer.querySelector('a');
      if (link) link.href = productUrl;
      viewAllContainer.classList.remove('hidden');
    }

    // 插入"Quantity"模拟 option：1 Pair（默认选中，显示当前价格）+ 3 Pairs（点击直接加 3 件跳转 /cart）
    // 解析套装配置 + 渲染 Quantity 栏目
    // bundleConfigs: 从商详页 <script data-quantity-bundle> 解析出的套装数组，无配置时为 null
    function injectQuantityBundle(productMain, bundleConfigs) {
      const form = productMain.querySelector('form[data-type="add-to-cart-form"]');
      if (!form) return;
      const buttonWrapper = form.querySelector('.wt-product__add-to-cart_form--wrapper');
      if (!buttonWrapper) return;
      if (form.querySelector('.xt-quantity-bundle')) return;

      // 读取当前售价数字（分），用于计算套装折后价
      function readCurrentPriceAmount() {
        const quickSection = productMain
          .querySelector('variant-options')
          ?.getAttribute('data-section');
        const priceEl = quickSection
          ? productMain.querySelector(`#price-${quickSection}`)
          : productMain.querySelector('.wt-product__price');
        if (!priceEl) return null;
        const final =
          priceEl.querySelector('.price-item--last') ||
          priceEl.querySelector('.wt-product__price__final') ||
          priceEl.querySelector('.price-item--regular');
        if (!final) return null;
        // 从 data 属性或文本解析金额，优先取主题写入的 data-price
        const dataPrice = final.getAttribute('data-price');
        if (dataPrice) return parseInt(dataPrice, 10);
        // 兜底：从文本里提取数字（去掉货币符号），结果乘 100 转成分
        const match = final.textContent.replace(/[^\d.,]/g, '').match(/[\d.,]+/);
        if (!match) return null;
        return Math.round(parseFloat(match[0].replace(',', '')) * 100);
      }

      // 读取当前售价文本（含货币符号），用于 1 Pair 展示
      function readCurrentPriceText() {
        const quickSection = productMain
          .querySelector('variant-options')
          ?.getAttribute('data-section');
        const priceEl = quickSection
          ? productMain.querySelector(`#price-${quickSection}`)
          : productMain.querySelector('.wt-product__price');
        if (!priceEl) return '';
        const final =
          priceEl.querySelector('.price-item--last') ||
          priceEl.querySelector('.wt-product__price__final') ||
          priceEl.querySelector('.price-item--regular');
        return final ? final.textContent.trim() : '';
      }

      // 用 Shopify 货币格式化（cents → 带符号文本）
      function formatMoney(cents) {
        if (typeof window.Shopify !== 'undefined' && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, window.Shopify.money_format || '${{amount}}');
        }
        // 兜底：简单拼接，保留两位小数
        return '$' + (cents / 100).toFixed(2);
      }

      // 计算套装折后总价（单件价 × 件数，再按百分比折扣扣减）
      // discount_value 直接就是百分比折扣值，如 20 = 打8折（减20%）
      function calcBundlePrice(unitPriceCents, bundle) {
        const subtotal = unitPriceCents * bundle.quantity;
        if (!bundle.discount_value) return subtotal;
        return Math.round(subtotal * (1 - bundle.discount_value / 100));
      }

      // 组装选项列表：1 Pair（常驻）+ 各套装配置
      const unitPrice = readCurrentPriceAmount();
      const optionsHtml = [
        // 1 Pair 始终存在，默认选中
        `<li class="f-button__list__item xt-quantity-bundle__item xt-quantity-bundle__item--selected">
          <button type="button" class="f-button__list__link xt-quantity-bundle__btn" data-qty="1">
            <span class="xt-quantity-bundle__label">1 Pair</span>
            <span class="xt-quantity-bundle__price">${readCurrentPriceText()}</span>
          </button>
        </li>`,
      ];

      // 套装选项（仅在配置了 metaobject 时生成）
      (bundleConfigs || []).forEach((bundle, idx) => {
        if (!bundle.quantity || bundle.quantity <= 1) return; // 件数≤1 跳过（和单件重复）
        const label = bundle.label || `${bundle.quantity} Pairs`;
        let badgeHtml = '';
        let priceHtml = '';
        if (unitPrice != null) {
          const bundlePrice = calcBundlePrice(unitPrice, bundle);
          const originalPrice = unitPrice * bundle.quantity;
          if (bundle.discount_value && bundlePrice < originalPrice) {
            // 有折扣：顶部促销徽章（省下的金额 + Free shipping）
            const savedAmount = originalPrice - bundlePrice;
            badgeHtml = `<span class="xt-quantity-bundle__badge">${formatMoney(savedAmount)} Off  Free shipping</span>`;
            // 价格区：折前价（左，划线）+ 折后价（右）
            priceHtml = `
              <div class="xt-quantity-bundle__prices">
                <span class="xt-quantity-bundle__price--compare">${formatMoney(originalPrice)}</span>
                <span class="xt-quantity-bundle__price">${formatMoney(bundlePrice)}</span>
              </div>`;
          } else {
            priceHtml = `
              <div class="xt-quantity-bundle__prices">
                <span class="xt-quantity-bundle__price">${formatMoney(bundlePrice)}</span>
              </div>`;
          }
        }
        optionsHtml.push(`
          <li class="f-button__list__item xt-quantity-bundle__item">
            <button type="button" class="f-button__list__link xt-quantity-bundle__btn" data-qty="${bundle.quantity}" data-bundle-idx="${idx}">
              ${badgeHtml}
              <span class="xt-quantity-bundle__label">${label}</span>
              ${priceHtml}
            </button>
          </li>`);
      });

      const bundle = document.createElement('div');
      bundle.className = 'wt-product__option js xt-quantity-bundle';
      bundle.innerHTML = `
        <div class="wt-product__option__wrapper">
          <div class="wt-product__option__title">Quantity</div>
        </div>
        <ul class="f-button__list xt-quantity-bundle__list">
          ${optionsHtml.join('')}
        </ul>
      `;
      form.insertBefore(bundle, buttonWrapper);

      // 选中态切换（所有按钮统一处理）
      bundle.querySelectorAll('.xt-quantity-bundle__btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const qty = parseInt(btn.getAttribute('data-qty'), 10);
          // 切换选中样式
          bundle.querySelectorAll('.xt-quantity-bundle__item').forEach((li) =>
            li.classList.remove('xt-quantity-bundle__item--selected'),
          );
          btn.closest('.xt-quantity-bundle__item').classList.add('xt-quantity-bundle__item--selected');

          // qty > 1 的套装：直接加购跳转 /cart；qty = 1 的单件：仅切换选中，不触发加购
          if (qty <= 1) return;
          const variantIdInput = form.querySelector('input[name="id"]');
          if (!variantIdInput || !variantIdInput.value) return;

          const tempForm = document.createElement('form');
          tempForm.method = 'POST';
          tempForm.action = `${window.Shopify?.routes?.root || '/'}cart/add`;
          tempForm.style.display = 'none';

          const idInput = document.createElement('input');
          idInput.type = 'hidden';
          idInput.name = 'id';
          idInput.value = variantIdInput.value;
          tempForm.appendChild(idInput);

          const qtyInput = document.createElement('input');
          qtyInput.type = 'hidden';
          qtyInput.name = 'quantity';
          qtyInput.value = String(qty);
          tempForm.appendChild(qtyInput);

          const redirectInput = document.createElement('input');
          redirectInput.type = 'hidden';
          redirectInput.name = 'return_to';
          redirectInput.value = '/cart';
          tempForm.appendChild(redirectInput);

          document.body.appendChild(tempForm);
          tempForm.submit();
        });
      });

      // 监听价格元素变化，实时同步各项价格（变体切换时）
      const quickSection = productMain
        .querySelector('variant-options')
        ?.getAttribute('data-section');
      const priceEl = quickSection
        ? productMain.querySelector(`#price-${quickSection}`)
        : null;
      if (priceEl) {
        const priceObserver = new MutationObserver(() => {
          const newUnitPrice = readCurrentPriceAmount();
          // 更新 1 Pair 价格
          const onePairBtn = bundle.querySelector('.xt-quantity-bundle__btn[data-qty="1"]');
          const onePairPrice = onePairBtn?.querySelector('.xt-quantity-bundle__price');
          if (onePairPrice) onePairPrice.textContent = readCurrentPriceText();
          // 更新各套装价格（折后价 + 划线原价 + 徽章省下金额）
          if (newUnitPrice != null) {
            (bundleConfigs || []).forEach((b, idx) => {
              if (b.quantity <= 1) return;
              const btn = bundle.querySelector(`[data-bundle-idx="${idx}"]`);
              if (!btn) return;
              const bundlePrice = calcBundlePrice(newUnitPrice, b);
              const originalPrice = newUnitPrice * b.quantity;
              // 折后价
              const priceEl = btn.querySelector('.xt-quantity-bundle__price:not(.xt-quantity-bundle__price--compare)');
              if (priceEl) priceEl.textContent = formatMoney(bundlePrice);
              // 划线原价
              const compareEl = btn.querySelector('.xt-quantity-bundle__price--compare');
              if (compareEl) compareEl.textContent = formatMoney(originalPrice);
              // 徽章（省下金额）
              const badgeEl = btn.querySelector('.xt-quantity-bundle__badge');
              if (badgeEl && bundlePrice < originalPrice) {
                badgeEl.textContent = `${formatMoney(originalPrice - bundlePrice)} Off  Free shipping`;
              }
            });
          }
        });
        priceObserver.observe(priceEl, { childList: true, subtree: true, characterData: true });
      }
    }

    function closeDrawer() {
      currentAbortController?.abort();
      drawer.hide();
    }

    closeBtn.addEventListener('click', closeDrawer);

    // 与主题 quick-add.js 保持一致：关闭时发布 quickBuyDrawerClose，
    // 打开完成后把焦点还给触发按钮（sl-after-hide 覆盖点击关闭 / Esc / 点遮罩等所有关闭路径）
    drawer.addEventListener('sl-after-hide', () => {
      publish(PUB_SUB_EVENTS.quickBuyDrawerClose, { source: 'xt-product-pickup' });
      contentEl.innerHTML = '';
      hideViewAllDetails();
      currentTrigger?.focus();
    });

    function fetchAndRenderProduct(productUrl) {
      contentEl.innerHTML = '';
      hideViewAllDetails();
      loaderEl.classList.remove('hidden');

      currentAbortController?.abort();
      const controller = new AbortController();
      currentAbortController = controller;

      fetch(productUrl, { signal: controller.signal })
        .then((res) => res.text())
        .then((html) => {
          loaderEl.classList.add('hidden');
          const doc = new DOMParser().parseFromString(html, 'text/html');

          const productCard = doc.querySelector('.wt-product');
          const productMain = doc.querySelector('.wt-product__main');
          const productInfo = doc.querySelector('.wt-product__info');
          if (!productCard || !productMain || !productInfo) return;

          // 清理主题动画类，避免依赖滚入视口触发的动画在抽屉里卡在半透明/隐藏状态
          productMain.querySelectorAll('.scroll-trigger.animate--slide-in').forEach((el) => {
            el.classList.remove('scroll-trigger', 'animate--slide-in');
          });

          // 清理不需要的元素（与主题 quick-add.js 保持一致的精简逻辑）
          const removeSelectors = [
            'collapsible-section',
            '[not-quick-add]',
            '.product__inventory',
            '.share-icons__container',
            '#gallery-loader',
            'pickup-availability',
            '.wt-product__sku',
            '.wt-product__feature-icons',
          ];
          removeSelectors.forEach((sel) => {
            productMain.querySelectorAll(sel).forEach((el) => el.remove());
          });

          // 从 gallery-section 里取第一张图，包成简单的 product-image 容器
          // （gallery-section 本身是带交互逻辑的自定义元素，直接整体注入不会正常工作）
          // 从 gallery-section 摘出所有媒体，组装成主题 <slideshow-section> 多图轮播
          // （gallery-section 自身带 swiper/缩略图联动等复杂状态，整体注入会失效，
          //  所以只取其 slide 节点的 innerHTML，外包 slideshow-section 让 slider.js 接管）
          const productGallery = productCard.querySelector('gallery-section');
          const gallerySlides = productGallery?.querySelectorAll('li[data-swiper-slide]') || [];
          const imageContainer = document.createElement('div');
          imageContainer.className = 'product-image';
          if (gallerySlides.length > 0) {
            const slidesHtml = [...gallerySlides]
              .map((li) => {
                const mediaId = li.getAttribute('data-media-id') || '';
                // 去掉 srcset，避免抽屉里加载多档大图；保留单 src
                const clone = li.cloneNode(true);
                clone.querySelectorAll('img').forEach((img) => img.removeAttribute('srcset'));
                return `<li class="swiper-slide" data-media-id="${mediaId}">${clone.innerHTML}</li>`;
              })
              .join('');
            imageContainer.innerHTML = `
              <slideshow-section class="xt-quick-add-carousel">
                <div class="xt-quick-add-carousel__viewport" data-swiper>
                  <ul class="xt-quick-add-carousel__track" data-swiper-container>
                    ${slidesHtml}
                  </ul>
                </div>
                <script data-swiper-configuration type="text/json">
                  {
                    "slidesPerView": 2.5,
                    "spaceBetween": 8,
                    "speed": 300,
                    "loop": false,
                    "threshold": 5
                  }
                <\/script>
              </slideshow-section>
            `;
          }

          // 标题包一层链接（可点击跳转完整详情页），并把品牌/标题/评分/价格/税费提示
          // 一起摘出来放进 product-info，和图片一起组成 wt-product__details
          // （与主题 quick-add.js 的摘要区排布保持一致）
          const titleEl = productInfo.querySelector('.wt-product__name');
          if (titleEl) {
            const link = document.createElement('a');
            link.textContent = titleEl.textContent;
            link.href = productUrl;
            titleEl.innerHTML = '';
            titleEl.appendChild(link);
            titleEl.setAttribute('tabindex', '0');
          }

          const productAbout = document.createElement('div');
          productAbout.className = 'product-info';
          // 按固定顺序逐个摘取，保证 品牌 → 标题 → 评分 → 价格 → 税费 的排列，
          // 不受商详页 Theme Editor 里 block 顺序影响（querySelectorAll 返回的是 DOM 顺序）
          ['.wt-product__brand', '.wt-product__name', '.wt-rating', '.wt-product__price', '.product__tax']
            .forEach((sel) => {
              const el = productInfo.querySelector(sel);
              if (el) productAbout.appendChild(el);
            });

          const productDetails = document.createElement('div');
          productDetails.className = 'wt-product__details';
          productDetails.appendChild(imageContainer);
          productDetails.appendChild(productAbout);

          productInfo.prepend(productDetails);

          // ID 改名（照抄主题 quick-add.js 的处理）：
          // variant-options / 价格 / 加购按钮 / 表单 / radio 都要重命名，
          // 否则 variants.js 内部用 getElementById 拼 id 找不到对应元素，
          // 图片联动、价格联动、按钮禁用状态都不会生效。
          const variantOptions = productMain.querySelector('variant-options');
          if (variantOptions) {
            variantOptions.dataset.updateUrl = 'false';
            const originalSection = variantOptions.getAttribute('data-section');
            variantOptions.setAttribute('data-original-section', originalSection);
            variantOptions.setAttribute('data-section', `quick-${originalSection}`);
          }
          const quickSection = variantOptions?.getAttribute('data-section');

          const priceEl = productMain.querySelector('.wt-product__price');
          if (priceEl && quickSection) priceEl.id = `price-${quickSection}`;

          const addBtn = productMain.querySelector('button[name="add"]');
          if (addBtn && quickSection) addBtn.id = `ProductSubmitButton-${quickSection}`;

          const addForm = productMain.querySelector('form[method="post"][data-type="add-to-cart-form"]');
          if (addForm && quickSection) addForm.id = `product-form-${quickSection}`;

          productMain.querySelectorAll('fieldset').forEach((fieldset) => {
            fieldset.querySelectorAll('input[type="radio"]').forEach((radio) => {
              const originalId = radio.getAttribute('id');
              if (!originalId) return;
              radio.setAttribute('id', `quick-${originalId}`);
              radio.setAttribute('form', `product-form-${quickSection}`);
            });
            fieldset.querySelectorAll('label').forEach((label) => {
              const originalFor = label.getAttribute('for');
              if (!originalFor) return;
              label.setAttribute('for', `quick-${originalFor}`);
            });
          });

          // 礼品卡：解除收件人字段禁用（与主题 quick-add.js 保持一致）
          const giftCardInput = productMain.querySelector(
            '[name="properties[__shopify_send_gift_card_to_recipient]"]',
          );
          giftCardInput?.removeAttribute('disabled');

          // 订阅/分期购：同步 section id，并把隐藏的 selling_plan input 的 form 属性指向新表单
          const subWidget = productMain.querySelector('.wt-subscription-widget');
          if (subWidget && quickSection) {
            const originalSection = variantOptions?.getAttribute('data-original-section');
            subWidget.setAttribute('data-section-id', quickSection);
            if (originalSection) subWidget.setAttribute('data-original-section-id', originalSection);
            subWidget.setAttribute('data-update-url-on-plan-change', 'false');

            const sellingPlanInput = subWidget.querySelector('input[name="selling_plan"]');
            sellingPlanInput?.setAttribute('form', `product-form-${quickSection}`);
          }

          // 把 productMain 包进 .wt-product 容器（保留主题 CSS 作用域，
          // 否则所有 .wt-product .xxx 子代选择器会失效，包括 product-form__input 等）
          const wtProductWrapper = document.createElement('div');
          wtProductWrapper.className = 'wt-product';
          wtProductWrapper.appendChild(productMain);
          contentEl.appendChild(wtProductWrapper);
          showViewAllDetails(productUrl);

          // 解析商详页输出的套装配置（<script data-quantity-bundle>），无配置时为 null
          let bundleConfigs = null;
          try {
            const bundleScript = doc.querySelector('script[data-quantity-bundle]');
            if (bundleScript && bundleScript.textContent.trim()) {
              bundleConfigs = JSON.parse(bundleScript.textContent);
            }
          } catch (e) {
            console.error('Quantity bundle config parse error:', e);
          }

          // 插入"Quantity"栏目：1 Pair（常驻）+ 套装（仅在有配置时展示）
          injectQuantityBundle(productMain, bundleConfigs);

          // 初始化变体选择器（如果主题用自定义元素承载变体切换逻辑）
          if (variantOptions && typeof variantOptions.initialize === 'function') {
            variantOptions.initialize();
          }

          // 监听 variant-options 的 data-featured-image-id 属性变化，
          // 切换 SKU 时把轮播滑动到对应媒体（替代旧的单图换 src 逻辑）。
          // data-featured-image-id 由 variants.js updateMedia() 写入 = variant.featured_media.id，
          // 与每个 slide 的 data-media-id 一一对应。
          if (variantOptions) {
            let lastFeaturedId = null;
            const observer = new MutationObserver(() => {
              const featuredId = variantOptions.getAttribute('data-featured-image-id');
              if (!featuredId || featuredId === lastFeaturedId) return;
              lastFeaturedId = featuredId;

              const slideshow = imageContainer.querySelector('slideshow-section');
              const swiper = slideshow?.swiper;
              const targetSlide = imageContainer.querySelector(
                `.swiper-slide[data-media-id="${featuredId}"]`,
              );

              if (swiper && targetSlide) {
                // 轮播已初始化：滑动到目标 slide
                const slideIndex = [...targetSlide.parentElement.children].indexOf(targetSlide);
                swiper.slideTo(slideIndex);
                swiper.update();
              } else if (targetSlide) {
                // 轮播还没初始化（slider.js 异步懒加载）：先把目标 slide 置顶，
                // 等 slideshow-section 升级后从这张图开始展示
                targetSlide.parentElement.prepend(targetSlide);
              }
            });
            observer.observe(variantOptions, {
              attributes: true,
              attributeFilter: ['data-featured-image-id'],
            });
          }
        })
        .catch((error) => {
          loaderEl.classList.add('hidden');
          if (error.name === 'AbortError') return;
          console.error('Quick-add drawer fetch error:', error);
        });
    }

    // 捕获阶段拦截，抢在主题 <quick-add> 的点击处理器之前触发（仅移动端）
    // PC 端不拦截，放行给主题原生 quick-add.js 的侧边栏
    section.addEventListener(
      'click',
      function (e) {
        const button = e.target.closest('.xt-product-pickup__item quick-add button');
        if (!button) return;
        if (!isMobile()) return; // PC 走原生侧边栏，不拦截

        e.preventDefault();
        e.stopImmediatePropagation();

        const productUrl = button.getAttribute('data-product-url');
        if (!productUrl) return;

        currentTrigger = button.closest('.card__picture-container')?.querySelector('a.card') || button;

        drawer.show();
        publish(PUB_SUB_EVENTS.quickBuyDrawerOpen, { source: 'xt-product-pickup' });
        fetchAndRenderProduct(productUrl);
      },
      true, // capture 阶段
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
  .xt-product-pickup {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 40px 20px;
  }
  .xt-product-pickup__header {
    text-align: center;
    margin-bottom: 32px;
  }
  .xt-product-pickup__title {
    margin: 0 0 8px;
    font-size: clamp(24px, 4vw, 36px);
  }
  .xt-product-pickup__subtitle {
    margin: 0;
    opacity: 0.7;
  }
  .xt-product-pickup__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .xt-product-pickup__item > color-swatch {
    width: 100%;
  }
  .xt-product-pickup__placeholder {
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed #ccc;
