  }
  .xt-color-swatch.unavailable {
    opacity: 0.3;
  }

  {%- comment -%} ============ 组件库 Drawer（sl-drawer）：底部弹层 80vh ============ {%- endcomment -%}
  .xt-quick-add-drawer {
    --size: 90vh;
  }
  .xt-quick-add-drawer::part(panel) {
    border-radius: 16px 16px 0 0;
  }
  .xt-quick-add-drawer::part(body) {
    padding: 0;
    position: relative;
  }
  .xt-quick-add-drawer__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 14px 16px;
  }
  .xt-quick-add-drawer__title {
    color: #000;
    font-family: Arial, sans-serif;
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.3px;
  }
  .xt-quick-add-drawer__close {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    cursor: pointer;
