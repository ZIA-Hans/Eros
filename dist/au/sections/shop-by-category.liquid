{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign image_class = 'shop-category__image-' | append: section_id
  assign placeholder_class = 'shop-category__placeholder-' | append: section_id
  assign desktop_left = section.settings.desktop_left_width | default: 44
  assign desktop_right = 100 | minus: desktop_left
  assign desktop_ratio = section.settings.desktop_main_ratio | default: '0.8' | plus: 0.0
  assign desktop_grid_ratio = desktop_ratio | times: 100 | divided_by: desktop_left
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  .shop-category-{{ section_id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .shop-category-{{ section_id }} * {
    box-sizing: border-box;
  }

  .shop-category__inner-{{ section_id }} {
    width: 100%;
    max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.mobile_max_width }}px{% else %}none{% endif %};
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .shop-category__heading-{{ section_id }} {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    text-align: center;
    font-weight: 400;
  }

  .shop-category__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
  }

  .shop-category__card-{{ section_id }} {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f6f6f6;
    color: inherit;
    text-decoration: none;
  }

  .shop-category__card-{{ section_id }}:hover,
  .shop-category__card-{{ section_id }}:focus {
    color: inherit;
    text-decoration: none;
  }

  .shop-category__card--wide-{{ section_id }} {
    grid-column: 1 / -1;
    aspect-ratio: {{ section.settings.wide_ratio }};
  }

  .shop-category__card--small-{{ section_id }} {
    aspect-ratio: {{ section.settings.small_ratio }};
  }

  .shop-category__picture-{{ section_id }} {
    position: absolute;
    inset: 0;
    display: block;
  }

  .shop-category__image-{{ section_id }},
  .shop-category__placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: var(--position-mobile, center);
  }

  .shop-category__content-{{ section_id }} {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ section.settings.text_gap }}px;
    padding: {{ section.settings.text_padding_mobile }}px;
    text-align: center;
    pointer-events: none;
  }

  .shop-category__title-{{ section_id }} {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    line-height: 1.35;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    font-weight: 700;
    text-decoration: {% if section.settings.title_underline %}underline{% else %}none{% endif %};
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    text-decoration-skip-ink: auto;
    padding-bottom: 4px;
    overflow-wrap: anywhere;
  }

  .shop-category__description-{{ section_id }} {
    margin: 0;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
  }

  @media screen and (min-width: 750px) {
    .shop-category-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .shop-category__inner-{{ section_id }} {
      max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.desktop_max_width }}px{% else %}none{% endif %};
      padding: 0 {{ section.settings.side_padding_desktop }}px;
    }

    .shop-category__heading-{{ section_id }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    .shop-category__grid-{{ section_id }} {
      grid-template-columns: minmax(0, {{ desktop_left }}fr) minmax(0, {{ desktop_right }}fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
      {% if section.settings.desktop_layout_mode == 'height' %}
      height: clamp(400px, 48vw, {{ section.settings.desktop_height }}px);
      {% else %}
      height: auto;
      aspect-ratio: {{ desktop_grid_ratio }};
      {% endif %}
    }

    .shop-category__card--wide-{{ section_id }} {
      grid-column: 1;
      grid-row: 1 / 3;
      aspect-ratio: auto;
    }

    .shop-category__card--small-{{ section_id }} {
      grid-column: 2;
      aspect-ratio: auto;
    }

    .shop-category__image-{{ section_id }} {
      object-position: var(--position-desktop, center);
    }

    .shop-category__content-{{ section_id }} {
      padding: {{ section.settings.text_padding_desktop }}px;
    }

    .shop-category__title-{{ section_id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
    }

    .shop-category__description-{{ section_id }} {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="shop-category-{{ section_id }}">
  <div class="shop-category__inner-{{ section_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="shop-category__heading-{{ section_id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="shop-category__grid-{{ section_id }}">
      <a class="shop-category__card-{{ section_id }} shop-category__card--wide-{{ section_id }}" href="{{ section.settings.link_1 | default: '#' }}">
        {% liquid
          assign mobile_image = section.settings.image_1 | default: section.settings.desktop_image_1
          assign desktop_image = section.settings.desktop_image_1 | default: mobile_image
          assign image_alt = mobile_image.alt | default: section.settings.title_1
          assign mobile_width = 749
          if section.settings.width_style == 'contained'
            assign mobile_width = section.settings.mobile_max_width | at_most: 749
          endif
          assign mobile_padding = section.settings.side_padding_mobile | times: 2
          assign desktop_padding = section.settings.side_padding_desktop | times: 2
          assign mobile_card_width = mobile_width | minus: mobile_padding
          assign desktop_share = desktop_left | divided_by: 100.0
          assign desktop_card_width = section.settings.desktop_max_width | minus: desktop_padding | minus: section.settings.gap | times: desktop_share
        %}
        {% capture desktop_sizes %}{% if section.settings.width_style == 'contained' %}(min-width: {{ section.settings.desktop_max_width }}px) {{ desktop_card_width }}px, {% endif %}calc((100vw - {{ desktop_padding }}px - {{ section.settings.gap }}px) * {{ desktop_share }}){% endcapture %}
        {% capture mobile_sizes %}(min-width: {{ mobile_width }}px) {{ mobile_card_width }}px, calc(100vw - {{ mobile_padding }}px){% endcapture %}
        {% if mobile_image != blank %}
          <picture class="shop-category__picture-{{ section_id }}" style="--position-mobile: {{ section.settings.mobile_position_1 | default: 'center' }}; --position-desktop: {{ section.settings.desktop_position_1 | default: 'center' }};">
            <source
              media="(min-width: 750px)"
              sizes="{{ desktop_sizes | strip }}"
              srcset="{% assign desktop_widths = '400,600,800,1000,1200,1600,2000' | split: ',' %}{% for candidate in desktop_widths %}{% assign candidate_width = candidate | plus: 0 %}{% if candidate_width < desktop_image.width %}{{ desktop_image | image_url: width: candidate_width }} {{ candidate_width }}w, {% endif %}{% endfor %}{{ desktop_image | image_url: width: desktop_image.width }} {{ desktop_image.width }}w"
            >
            {{ mobile_image | image_url: width: 1500 | image_tag: class: image_class, widths: '240,360,480,600,750,900,1200,1500', sizes: mobile_sizes, alt: image_alt, loading: 'lazy' }}
          </picture>
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_1 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_1 }}</p>
          {% endif %}
          {% if section.settings.description_1 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_1 }}</p>
          {% endif %}
        </div>
      </a>

      <a class="shop-category__card-{{ section_id }} shop-category__card--small-{{ section_id }}" href="{{ section.settings.link_2 | default: '#' }}">
        {% liquid
          assign mobile_image = section.settings.image_2 | default: section.settings.desktop_image_2
          assign desktop_image = section.settings.desktop_image_2 | default: mobile_image
          assign image_alt = mobile_image.alt | default: section.settings.title_2
          assign mobile_width = 749
          if section.settings.width_style == 'contained'
            assign mobile_width = section.settings.mobile_max_width | at_most: 749
          endif
          assign mobile_padding = section.settings.side_padding_mobile | times: 2
          assign desktop_padding = section.settings.side_padding_desktop | times: 2
          assign mobile_card_width = mobile_width | minus: mobile_padding
          assign desktop_share = desktop_right | divided_by: 100.0
          assign desktop_card_width = section.settings.desktop_max_width | minus: desktop_padding | minus: section.settings.gap | times: desktop_share
        %}
        {% capture desktop_sizes %}{% if section.settings.width_style == 'contained' %}(min-width: {{ section.settings.desktop_max_width }}px) {{ desktop_card_width }}px, {% endif %}calc((100vw - {{ desktop_padding }}px - {{ section.settings.gap }}px) * {{ desktop_share }}){% endcapture %}
        {% capture mobile_sizes %}(min-width: {{ mobile_width }}px) {{ mobile_card_width | minus: section.settings.gap | divided_by: 2.0 }}px, calc((100vw - {{ mobile_padding }}px - {{ section.settings.gap }}px) / 2){% endcapture %}
        {% if mobile_image != blank %}
          <picture class="shop-category__picture-{{ section_id }}" style="--position-mobile: {{ section.settings.mobile_position_2 | default: 'center' }}; --position-desktop: {{ section.settings.desktop_position_2 | default: 'center' }};">
            <source
              media="(min-width: 750px)"
              sizes="{{ desktop_sizes | strip }}"
              srcset="{% assign desktop_widths = '400,600,800,1000,1200,1600,2000' | split: ',' %}{% for candidate in desktop_widths %}{% assign candidate_width = candidate | plus: 0 %}{% if candidate_width < desktop_image.width %}{{ desktop_image | image_url: width: candidate_width }} {{ candidate_width }}w, {% endif %}{% endfor %}{{ desktop_image | image_url: width: desktop_image.width }} {{ desktop_image.width }}w"
            >
            {{ mobile_image | image_url: width: 1500 | image_tag: class: image_class, widths: '240,360,480,600,750,900,1200,1500', sizes: mobile_sizes, alt: image_alt, loading: 'lazy' }}
          </picture>
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_2 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_2 }}</p>
          {% endif %}
          {% if section.settings.description_2 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_2 }}</p>
          {% endif %}
        </div>
      </a>

      <a class="shop-category__card-{{ section_id }} shop-category__card--small-{{ section_id }}" href="{{ section.settings.link_3 | default: '#' }}">
        {% liquid
          assign mobile_image = section.settings.image_3 | default: section.settings.desktop_image_3
          assign desktop_image = section.settings.desktop_image_3 | default: mobile_image
          assign image_alt = mobile_image.alt | default: section.settings.title_3
          assign mobile_width = 749
          if section.settings.width_style == 'contained'
            assign mobile_width = section.settings.mobile_max_width | at_most: 749
          endif
          assign mobile_padding = section.settings.side_padding_mobile | times: 2
          assign desktop_padding = section.settings.side_padding_desktop | times: 2
          assign mobile_card_width = mobile_width | minus: mobile_padding
          assign desktop_share = desktop_right | divided_by: 100.0
          assign desktop_card_width = section.settings.desktop_max_width | minus: desktop_padding | minus: section.settings.gap | times: desktop_share
        %}
        {% capture desktop_sizes %}{% if section.settings.width_style == 'contained' %}(min-width: {{ section.settings.desktop_max_width }}px) {{ desktop_card_width }}px, {% endif %}calc((100vw - {{ desktop_padding }}px - {{ section.settings.gap }}px) * {{ desktop_share }}){% endcapture %}
        {% capture mobile_sizes %}(min-width: {{ mobile_width }}px) {{ mobile_card_width | minus: section.settings.gap | divided_by: 2.0 }}px, calc((100vw - {{ mobile_padding }}px - {{ section.settings.gap }}px) / 2){% endcapture %}
        {% if mobile_image != blank %}
          <picture class="shop-category__picture-{{ section_id }}" style="--position-mobile: {{ section.settings.mobile_position_3 | default: 'center' }}; --position-desktop: {{ section.settings.desktop_position_3 | default: 'center' }};">
            <source
              media="(min-width: 750px)"
              sizes="{{ desktop_sizes | strip }}"
              srcset="{% assign desktop_widths = '400,600,800,1000,1200,1600,2000' | split: ',' %}{% for candidate in desktop_widths %}{% assign candidate_width = candidate | plus: 0 %}{% if candidate_width < desktop_image.width %}{{ desktop_image | image_url: width: candidate_width }} {{ candidate_width }}w, {% endif %}{% endfor %}{{ desktop_image | image_url: width: desktop_image.width }} {{ desktop_image.width }}w"
            >
            {{ mobile_image | image_url: width: 1500 | image_tag: class: image_class, widths: '240,360,480,600,750,900,1200,1500', sizes: mobile_sizes, alt: image_alt, loading: 'lazy' }}
          </picture>
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_3 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_3 }}</p>
          {% endif %}
          {% if section.settings.description_3 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_3 }}</p>
          {% endif %}
        </div>
      </a>
    </div>
  </div>
</div>

