      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size - mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
