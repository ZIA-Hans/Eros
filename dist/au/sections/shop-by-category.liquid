      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop image area max height",
      "info": "Used only in Limit height mode. Image proportions change as the screen gets wider.",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "select",
      "id": "desktop_layout_mode",
      "label": "Desktop layout mode",
      "options": [
        { "value": "ratio", "label": "Keep proportions" },
        { "value": "height", "label": "Limit height" }
      ],
      "default": "ratio",
      "info": "Keep proportions: use Contained width to avoid oversized layouts on wide screens."
    },
    {
      "type": "range",
      "id": "desktop_left_width",
      "label": "Desktop left image width",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 44
    },
    {
      "type": "select",
      "id": "desktop_main_ratio",
      "label": "Desktop main image ratio",
      "options": [
        { "value": "0.666667", "label": "2:3 - portrait" },
        { "value": "0.75", "label": "3:4 - portrait" },
